{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "للكمبيوتر فقط: تحديثات خامة وإعادة التشغيل، فتح صفحة الإصدارات، وسحب الملفات المنزّلة إلى برامج أخرى، وشريط العنوان الخاص (تصغير، تكبير، إغلاق، سحب النافذة)",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/jake750/khama/*"
        }
      ]
    },
    "drag:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
