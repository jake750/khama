{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "للكمبيوتر فقط: تحديثات خامة وإعادة التشغيل، فتح صفحة الإصدارات، وسحب الملفات المنزّلة إلى برامج أخرى",
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/jake750/khama/*"
        }
      ]
    },
    "drag:default"
  ]
}