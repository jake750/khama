{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "صلاحيات النافذة الرئيسية: الأساسيات، نافذتا اختيار المجلد وحفظ النسخة الاحتياطية، الإشعارات، وقراءة الحافظة وكتابتها",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "os:allow-platform",
    "os:allow-version",
    "core:window:allow-set-progress-bar"
  ]
}