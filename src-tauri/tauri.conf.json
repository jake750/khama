{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Khama",
  "version": "0.3.2",
  "identifier": "com.jake750.khama",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Khama",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' https: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "category": "Video",
    "shortDescription": "Media downloader for video editors",
    "license": "MIT",
    "externalBin": ["binaries/khama-yt-dlp", "binaries/khama-deno"],
    "resources": {
      "binaries/ffmpeg/": "ffmpeg/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/jake750/khama/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
