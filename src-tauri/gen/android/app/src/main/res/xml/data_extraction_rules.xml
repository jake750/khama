<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 وما بعده: نفس قاعدة backup_rules.xml للنسخ السحابي والنقل بين الأجهزة -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="cookies.txt" />
    <exclude domain="root" path="cookies.txt.tmp" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="cookies.txt" />
    <exclude domain="root" path="cookies.txt.tmp" />
  </device-transfer>
</data-extraction-rules>
